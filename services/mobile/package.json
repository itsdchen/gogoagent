{
  "name": "@gogoagent/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "corepack pnpm --filter @gogoagent/shared build && tsc -p tsconfig.json && node ./scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "corepack pnpm --filter @gogoagent/shared build && tsc -p tsconfig.json --noEmit",
    "lint": "corepack pnpm --filter @gogoagent/shared build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gogoagent/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
